# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*

# Vendored wintun DLLs are embedded by //go:embed and must be committed.
!third_party/sing-tun/internal/wintun/**/wintun.dll

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# go mod vendor
vendor

# GoLand
.idea/*

# macOS file
.DS_Store

# test suite
test/config/cache*
/output
.vscode/
.fleet/